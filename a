/* Modernized Button Gallery CSS */

html, body {
    min-height: 100vh;
    margin: 0;
    padding: 40px 20px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    background: radial-gradient(circle at top left, #2b1055, #7597de);
    color: #f0f0f0;
    font-family: 'Poppins', sans-serif;
    -webkit-font-smoothing: antialiased;
    scroll-behavior: smooth;
}

.container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
    max-width: 1200px;
    background: rgba(0, 0, 0, 0.7);
    padding: 30px;
    border-radius: 16px;
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.4);
}

.card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    width: 220px;
    height: 240px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 14px;
    text-align: center;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
}

.btn {
    position: relative;
    padding: 14px 36px;
    border: none;
    border-radius: 10px;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
    background: linear-gradient(90deg, #6a11cb, #2575fc);
    box-shadow: 0 6px 16px rgba(37,117,252,0.3);
    transition: all 0.25s ease;
}

.btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(106,17,203,0.4);
}

.btn:active {
    transform: translateY(1px);
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

/* Variant Improvements */

.btn-outline {
    background: transparent;
    border: 2px solid #6a11cb;
    color: #6a11cb;
}
.btn-outline:hover {
    background: #6a11cb;
    color: #fff;
}

.btn-gradient {
    background: linear-gradient(135deg, #ff7eb3, #ff758c);
    box-shadow: 0 8px 20px rgba(255,117,140,0.3);
}

.btn-3d {
    background: linear-gradient(to bottom, #fefefe, #d9d9d9);
    color: #222;
    box-shadow: 0 5px 0 #c7c7c7, 0 14px 20px rgba(0,0,0,0.2);
}
.btn-3d:active {
    transform: translateY(5px);
    box-shadow: 0 3px 0 #c7c7c7, 0 8px 12px rgba(0,0,0,0.25);
}

.btn-neon {
    background: transparent;
    color: #00e5ff;
    border: 2px solid rgba(0, 229, 255, 0.5);
    text-shadow: 0 0 5px #00e5ff;
    box-shadow: 0 0 15px rgba(0,229,255,0.4);
}
.btn-neon:hover {
    box-shadow: 0 0 30px rgba(0,229,255,0.8), inset 0 0 6px rgba(0,229,255,0.3);
}

.btn-glass {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.25);
}

.btn-ripple {
    overflow: hidden;
    background: linear-gradient(90deg, #36d1dc, #5b86e5);
}
.btn-ripple::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    background: rgba(255,255,255,0.5);
    left: 50%;
    top: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
    transition: transform .5s ease, opacity .6s ease;
}
.btn-ripple:active::after {
    transform: translate(-50%, -50%) scale(10);
    opacity: 1;
}

.btn-split {
    background: linear-gradient(90deg, #ffb347 50%, #ffcc33 50%);
    background-size: 200% 100%;
    transition: background-position .3s ease;
}
.btn-split:hover {
    background-position: -100% 0;
    transform: translateY(-2px);
}

.btn-wavy {
    border: 2px solid rgba(255,255,255,0.2);
    background: transparent;
    color: #fff;
    position: relative;
}
.btn-wavy::after {
    content: '';
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 6px;
    height: 2px;
    background: linear-gradient(90deg,#ff758c,#ffa751);
    animation: wave 5s linear infinite;
}
@keyframes wave {
    0% {background-position: 0 0;}
    50% {background-position: 100% 0;}
    100% {background-position: 0 0;}
}

.btn-icon-circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 22px;
    background: radial-gradient(circle, #ffb347, #ffcc33);
    color: #111;
}

.btn-loading {
    position: relative;
    background: linear-gradient(90deg, #6366f1, #8b5cf6);
    padding-right: 42px;
}
.btn-loading::before {
    content: '';
    position: absolute;
    right: 14px;
    top: 50%;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255,255,255,0.4);
    border-top-color: #fff;
    border-radius: 50%;
    transform: translateY(-50%);
    animation: spin 1s linear infinite;
}
@keyframes spin {
    to { transform: translateY(-50%) rotate(360deg); }
}
